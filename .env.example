# ========================================================
# SakuIN Environment Variables
# ========================================================

# Supabase Public Configuration (bisa pakai PUBLISHABLE_KEY atau ANON_KEY)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
# Alternatif: NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Server-Only Secrets (Never expose to client!)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database Connection String for Drizzle ORM
# For Supabase Transaction Pooler (Serverless / Vercel), port is usually 6543
# e.g.: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sakuin"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
